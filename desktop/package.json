{
  "name": "file-converter-desktop",
  "productName": "File Converter",
  "version": "1.0.0",
  "description": "Convert PDFs, documents, spreadsheets and images on your computer, offline.",
  "author": "Tonny",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.hitonnie.fileconverter",
    "productName": "File Converter",
    "copyright": "Copyright © 2026 Tonny",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "app/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "File Converter",
      "uninstallDisplayName": "File Converter",
      "artifactName": "File-Converter-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "heic2any": "0.0.4",
    "html2canvas": "1.4.1",
    "jszip": "3.10.1",
    "mammoth": "1.6.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "sortablejs": "1.15.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
